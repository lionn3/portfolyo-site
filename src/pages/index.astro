          </a>
          <a href="https://music.apple.com" target="_blank" title="Apple Music" aria-label="Apple Music">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M23.994 6.124a9.23 9.23 0 00-.24-2.19c-.317-1.31-1.062-2.31-2.18-3.043a5.022 5.022 0 00-1.877-.726 10.496 10.496 0 00-1.564-.15H5.988c-.152.01-.303.017-.455.026-.747.043-1.49.123-2.193.4-1.336.53-2.3 1.452-2.865 2.78-.192.448-.292.925-.363 1.408-.056.392-.088.785-.1 1.18v12.316c.01.14.017.283.027.424.05.815.154 1.624.497 2.373.65 1.42 1.738 2.353 3.234 2.802.42.127.856.187 1.293.228.555.053 1.11.06 1.667.06h11.03c.525 0 1.048-.034 1.57-.1.823-.106 1.597-.35 2.296-.81a5.046 5.046 0 001.88-2.207c.186-.42.293-.87.37-1.324.113-.675.138-1.358.137-2.04-.002-3.8 0-7.595-.003-11.393z"/></svg>
          </a>
          <a href="https://youtube.com" target="_blank" title="YouTube" aria-label="YouTube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="https://github.com/lionn3" target="_blank" title="GitHub" aria-label="GitHub">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
        </div>
      </div>
    </div>
  </nav>

  <div class="container">
    <header class="hero">
      <h1 data-i18n="heroTitle">Composition & Sound Design for Interactive Media and Stage.</h1>
      <p data-i18n="heroSub">Crafting immersive audio experiences for games, theater, and interactive media.</p>
    </header>

    <section id="works" class="section">
      <div class="section-header">
        <h2 class="section-title" data-i18n="secWorks">Selected Works</h2>
        <div class="filter-pills">
          <button type="button" class="pill active" data-filter="all" data-i18n="filterAll">All</button>
          <button type="button" class="pill" data-filter="catGame" data-i18n="filterGame">Game Audio</button>
          <button type="button" class="pill" data-filter="catTheater" data-i18n="filterTheater">Theater Score</button>
          <button type="button" class="pill" data-filter="catConcept" data-i18n="filterConcept">Speculative / Loops</button>
        </div>
      </div>

      <div class="works-grid">
        {projects.map((p) => (
          <article
            class="work-card"
            data-cat={p.categoryKey}
            data-src={p.src}
            data-title={p.title}
            data-badge={p.badge}
            data-desc-en={p.desc.en}
            data-desc-fr={p.desc.fr}
          >
            <div class="work-thumb">
              <img src={p.image} alt={p.title} width="400" height="150" loading="lazy" />
              <span class="work-badge">{p.badge}</span>
            </div>
            <div class="work-body">
              <p class="work-desc">{p.desc.en}</p>
              <div class="work-footer">
                <span class="work-title">{p.title}</span>
                <button type="button" class={`work-play-btn ${p.accent}`} aria-label="Play track">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="discography" class="section">
      <div class="section-header">
        <h2 class="section-title" data-i18n="secDisco">Selected Discography</h2>
      </div>

      <div class="disco-grid">
        {discography.map((d) => (
          <div class="disco-card">
            <div class="disco-cover">
              <img src={d.cover} alt={d.title} width="400" height="140" loading="lazy" />
              <div class="disco-overlay-title">{d.title}</div>
            </div>
            <div class="disco-meta">
              <span>{d.year} • {d.genre}</span>
              <div class="disco-links">
                <a href={d.spotify} target="_blank">SP</a>
                <a href={d.apple} target="_blank">AM</a>
                <a href={d.youtube} target="_blank">YT</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="about" class="section">
      <div class="about-box">
        <div class="about-text">
          <h3 data-i18n="aboutHeading">Profile & Musical Architecture</h3>
          <p data-i18n="aboutP1">
            Composer and sound designer focusing on narrative-driven game scores, theatrical productions, and electroacoustic composition. Combining formal musicological analysis (Sorbonne Université) with modern synthesis and modular audio workflows.
          </p>
          <p data-i18n="aboutP2">
            Available for original soundtrack scoring, interactive audio implementation, and stage sound design collaborations in Paris and internationally.
          </p>
          <p style="margin-top:1.2rem;">
            <a href="mailto:arhanboraegemen@gmail.com" style="color: var(--accent-amber); text-decoration: none; font-weight: 600;">
              arhanboraegemen@gmail.com →
            </a>
          </p>
        </div>

        <div class="specs-list">
          <div class="spec-group">
            <h4 data-i18n="spec1">Production & Synthesis</h4>
            <div class="spec-tags">
              <span class="spec-tag">Ableton Live 12 Suite</span>
              <span class="spec-tag">FL Studio</span>
              <span class="spec-tag">ReaPlugs DSP</span>
              <span class="spec-tag">Sound Design & Foley</span>
            </div>
          </div>
          <div class="spec-group">
            <h4 data-i18n="spec2">Domains & Theory</h4>
            <div class="spec-tags">
              <span class="spec-tag">Interactive Game Loops</span>
              <span class="spec-tag">Theatrical Cues</span>
              <span class="spec-tag">Formal Musicology</span>
              <span class="spec-tag">Acoustic Arrangement</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="player-bar">
    <div class="player-inner">
      <div class="player-left">
        <div class="transport-controls">
          <button type="button" id="btn-prev" class="ctrl-icon-btn" aria-label="Previous">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
          </button>
          <button type="button" id="btn-play" class="play-main-btn" aria-label="Play or Pause">
            <svg id="svg-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            <svg id="svg-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="display:none;"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
          </button>
          <button type="button" id="btn-next" class="ctrl-icon-btn" aria-label="Next">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
          </button>
        </div>

        <div class="now-playing-info">
          <span id="np-title" class="np-title">Arhan Bora Egemen — Select a Work</span>
          <span id="np-sub" class="np-sub">Ready to play</span>
        </div>
      </div>

      <div class="player-center">
        <span id="time-curr" class="time-label">0:00</span>
        <div id="wave-box" class="wave-box">
          <canvas id="waveform"></canvas>
        </div>
        <span id="time-total" class="time-label">0:00</span>
      </div>

      <div class="player-right">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--accent-amber-soft)"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
        <input type="range" id="vol-slider" class="vol-slider" min="0" max="1" step="0.05" value="0.85" />
      </div>
    </div>
  </div>

  <audio id="audio-el" preload="metadata"></audio>

  <script is:inline>
    const dict = {
      en: {
        navWorks: "Works",
        navDisco: "Discography",
        navAbout: "About",
        heroTitle: "Composition & Sound Design for Interactive Media and Stage.",
        heroSub: "Crafting immersive audio experiences for games, theater, and interactive media.",
        secWorks: "Selected Works",
        filterAll: "All",
        filterGame: "Game Audio",
        filterTheater: "Theater Score",
        filterConcept: "Speculative / Loops",
        secDisco: "Selected Discography",
        aboutHeading: "Profile & Musical Architecture",
        aboutP1: "Composer and sound designer focusing on narrative-driven game scores, theatrical productions, and electroacoustic composition. Combining formal musicological analysis (Sorbonne Université) with modern synthesis and modular audio workflows.",
        aboutP2: "Available for original soundtrack scoring, interactive audio implementation, and stage sound design collaborations in Paris and internationally.",
        spec1: "Production & Synthesis",
        spec2: "Domains & Theory"
      },
      fr: {
        navWorks: "Projets",
        navDisco: "Discographie",
        navAbout: "À Propos",
        heroTitle: "Composition & Sound Design pour Médias Interactifs et Scène.",
        heroSub: "Création d'expériences sonores immersives pour le jeu vidéo, le théâtre et les médias linéaires.",
        secWorks: "Projets Sélectionnés",
        filterAll: "Tous",
        filterGame: "Jeu Vidéo",
        filterTheater: "Théâtre & Scène",
        filterConcept: "Spéculatif / Boucles",
        secDisco: "Discographie Sélectionnée",
        aboutHeading: "Profil & Architecture Musicale",
        aboutP1: "Compositeur et sound designer spécialisé dans les bandes originales de jeux vidéo, la musique de scène et la composition électroacoustique. Alliance entre analyse musicologique formelle (Sorbonne Université) et synthèse sonore moderne.",
        aboutP2: "Disponible pour la composition de bandes originales, l'intégration audio interactive et le sound design théâtral à Paris et à l'international.",
        spec1: "Production & Synthèse",
        spec2: "Domaines & Théorie"
      }
    };

    const langBtns = document.querySelectorAll('.lang-btn');
    const i18nEls = document.querySelectorAll('[data-i18n]');
    const workCards = Array.from(document.querySelectorAll('.work-card'));

    langBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        langBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        i18nEls.forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (dict[lang][key]) el.textContent = dict[lang][key];
        });

        workCards.forEach(card => {
          const descEl = card.querySelector('.work-desc');
          descEl.textContent = card.getAttribute(`data-desc-${lang}`);
        });
      });
    });

    const pills = document.querySelectorAll('.pill');
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const filter = pill.getAttribute('data-filter');

        workCards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-cat') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    const audio = document.getElementById('audio-el');
    const btnPlay = document.getElementById('btn-play');
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const svgPlay = document.getElementById('svg-play');
    const svgPause = document.getElementById('svg-pause');
    const npTitle = document.getElementById('np-title');
    const npSub = document.getElementById('np-sub');
    const timeCurr = document.getElementById('time-curr');
    const timeTotal = document.getElementById('time-total');
    const volSlider = document.getElementById('vol-slider');
    const waveBox = document.getElementById('wave-box');
    const canvas = document.getElementById('waveform');
    const ctx = canvas.getContext('2d');

    let currentIndex = -1;
    let audioCtx, analyser, dataArray;
    let isAudioSetup = false;

    function setupAudioGraph() {
      if (isAudioSetup) return;
      try {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 128;
        const srcNode = audioCtx.createMediaElementSource(audio);
        srcNode.connect(analyser);
        analyser.connect(audioCtx.destination);
        dataArray = new Uint8Array(analyser.frequencyBinCount);
        isAudioSetup = true;
      } catch (e) {}
    }

    function resizeCanvas() {
      const dpr = window.devicePixelRatio || 1;
      const w = waveBox.clientWidth || 300;
      const h = waveBox.clientHeight || 34;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function renderWaveform() {
      requestAnimationFrame(renderWaveform);
      const w = waveBox.clientWidth || 300;
      const h = waveBox.clientHeight || 34;
      ctx.clearRect(0, 0, w, h);

      const bars = 48;
      const gap = 3;
      const barWidth = Math.max(2, (w - (bars - 1) * gap) / bars);
      const progressRatio = audio.duration ? (audio.currentTime / audio.duration) : 0;

      if (isAudioSetup && !audio.paused) {
        analyser.getByteFrequencyData(dataArray);
      }

      const gradActive = ctx.createLinearGradient(0, 0, w, 0);
      gradActive.addColorStop(0, '#f59e0b');
      gradActive.addColorStop(0.55, '#c084fc');
      gradActive.addColorStop(1, '#8b5cf6');

      for (let i = 0; i < bars; i++) {
        let amp = 0.22 + Math.sin(i * 0.45) * 0.12;
        if (isAudioSetup && !audio.paused) {
          amp = Math.max(0.15, dataArray[i % dataArray.length] / 255);
        }
        const barH = Math.max(4, amp * (h - 4));
        const x = i * (barWidth + gap);
        const y = (h - barH) / 2;

        const barRatio = i / bars;
        ctx.fillStyle = (barRatio <= progressRatio && !audio.paused) ? gradActive : 'rgba(229, 179, 120, 0.35)';
        ctx.fillRect(x, y, barWidth, barH);
      }
    }
    renderWaveform();

    function formatSec(s) {
      if (!s || isNaN(s)) return "0:00";
      const m = Math.floor(s / 60);
      const sec = Math.floor(s % 60);
      return `${m}:${sec < 10 ? '0' : ''}${sec}`;
    }

    function loadTrack(index) {
      if (index < 0 || index >= workCards.length) return;
      setupAudioGraph();
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();

      currentIndex = index;
      const card = workCards[index];
      const src = card.getAttribute('data-src');
      const title = card.getAttribute('data-title');
      const badge = card.getAttribute('data-badge');

      workCards.forEach(c => c.classList.remove('playing'));
      card.classList.add('playing');

      npTitle.textContent = `Arhan Bora Egemen — ${title}`;
      npSub.textContent = badge;

      audio.src = src;
      audio.play().then(() => {
        svgPlay.style.display = 'none';
        svgPause.style.display = 'block';
      }).catch(() => {
        svgPlay.style.display = 'block';
        svgPause.style.display = 'none';
      });
    }

    workCards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        if (currentIndex === idx && !audio.paused) {
          audio.pause();
          svgPlay.style.display = 'block';
          svgPause.style.display = 'none';
        } else if (currentIndex === idx && audio.paused && audio.src) {
          audio.play();
          svgPlay.style.display = 'none';
          svgPause.style.display = 'block';
        } else {
          loadTrack(idx);
        }
      });
    });

    btnPlay.addEventListener('click', () => {
      if (currentIndex === -1) {
        loadTrack(0);
        return;
      }
      if (audio.paused) {
        audio.play();
        svgPlay.style.display = 'none';
        svgPause.style.display = 'block';
      } else {
        audio.pause();
        svgPlay.style.display = 'block';
        svgPause.style.display = 'none';
      }
    });

    btnPrev.addEventListener('click', () => {
      if (currentIndex > 0) loadTrack(currentIndex - 1);
    });

    btnNext.addEventListener('click', () => {
      if (currentIndex < workCards.length - 1) loadTrack(currentIndex + 1);
    });

    audio.addEventListener('timeupdate', () => {
      timeCurr.textContent = formatSec(audio.currentTime);
      timeTotal.textContent = formatSec(audio.duration);
    });

    waveBox.addEventListener('click', (e) => {
      if (!audio.duration) return;
      const rect = waveBox.getBoundingClientRect();
      const ratio = (e.clientX - rect.left) / rect.width;
      audio.currentTime = ratio * audio.duration;
    });

    volSlider.addEventListener('input', (e) => {
      audio.volume = e.target.value;
    });
  </script>
</body>
</html>