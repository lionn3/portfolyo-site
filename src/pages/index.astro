  </nav>

  <div class="container">
    <header class="hero">
      <h1 data-i18n="heroTitle">Composition & Sound Design for Interactive Media and Stage.</h1>
      <p data-i18n="heroSub">Crafting immersive audio experiences for games, theater, and interactive media.</p>
    </header>

    <!-- Selected Projects Section -->
    <section id="works" class="section">
      <div class="section-header">
        <h2 class="section-title" data-i18n="secWorks">Selected Works & Productions</h2>
        <div class="filter-pills">
          <button type="button" class="pill active" data-filter="all" data-i18n="filterAll">All</button>
          <button type="button" class="pill" data-filter="theater" data-i18n="filterTheater">Theater Scores</button>
          <button type="button" class="pill" data-filter="game" data-i18n="filterGame">Game OST</button>
          <button type="button" class="pill" data-filter="sfx" data-i18n="filterSfx">Sound Design / SFX</button>
        </div>
      </div>

      <div class="projects-grid">
        {projects.map((p) => (
          <article class="project-card" data-cat={p.category}>
            <div class="project-top">
              <div class="project-cover">
                <img
                  src={`${p.coverBase}.jpg`}
                  data-png={`${p.coverBase}.png`}
                  data-fallback={p.fallbackCover}
                  onerror="if(!this.dataset.triedPng){this.dataset.triedPng='1';this.src=this.dataset.png;}else{this.onerror=null;this.src=this.dataset.fallback;}"
                  alt={p.title.en}
                  loading="lazy"
                />
              </div>

              <div class="project-info">
                <div class="project-meta-row">
                  <span class={`project-badge ${p.accent}`} data-en={p.badge.en} data-fr={p.badge.fr}>{p.badge.en}</span>
                  {p.externalUrl && (
                    <a href={p.externalUrl} target="_blank" class="ext-link">{p.externalLabel} ↗</a>
                  )}
                </div>
                <h3 class="project-title" data-en={p.title.en} data-fr={p.title.fr}>{p.title.en}</h3>
                <div class="project-sub">{p.subtitle}</div>
                <p class="project-desc" data-en={p.desc.en} data-fr={p.desc.fr}>{p.desc.en}</p>
              </div>
            </div>

            <div class="tracklist">
              {p.tracks.map((t) => (
                <div
                  class="track-row playable-item"
                  data-src={t.src}
                  data-title={t.title}
                  data-project={p.title.en}
                >
                  <div class="track-row-left">
                    <button type="button" class="mini-play-btn" aria-label="Play">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                      </svg>
                    </button>
                    <span class="track-row-title">{t.title}</span>
                  </div>
                  <span class="track-row-note" data-en={t.noteEn} data-fr={t.noteFr}>{t.noteEn}</span>
                </div>
              ))}
            </div>

            {p.sfxPads && (
              <div class="sfx-pad-box">
                <span class="sfx-pad-label" data-i18n="sfxPadTitle">Interactive Gameplay SFX Triggers:</span>
                <div class="sfx-pads">
                  {p.sfxPads.map((pad) => (
                    <button
                      type="button"
                      class="sfx-btn playable-item"
                      data-src={pad.src}
                      data-title={pad.label}
                      data-project={p.title.en}
                    >
                      ▶ {pad.label}
                    </button>
                  ))}
                </div>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <!-- Autonomous Releases & Streaming Section -->
    <section id="discography" class="section">
      <div class="section-header">
        <h2 class="section-title" data-i18n="secDisco">Autonomous Works & Streaming</h2>
      </div>

      <div class="disco-grid">
        {releases.map((r) => (
          <div
            class="release-card playable-item"
            data-src={r.src}
            data-title={r.title}
            data-project="Autonomous Release"
          >
            <div class="release-left">
              <div class="release-cover">
                <img
                  src={`${r.coverBase}.jpg`}
                  data-png={`${r.coverBase}.png`}
                  data-fallback={r.fallbackCover}
                  onerror="if(!this.dataset.triedPng){this.dataset.triedPng='1';this.src=this.dataset.png;}else{this.onerror=null;this.src=this.dataset.fallback;}"
                  alt={r.title}
                  loading="lazy"
                />
              </div>
              <div>
                <div class="release-title">{r.title}</div>
                <div class="release-sub" data-en={r.subtitleEn} data-fr={r.subtitleFr}>{r.subtitleEn}</div>
              </div>
            </div>
            <button type="button" class="release-play" aria-label="Play release">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </button>
          </div>
        ))}
      </div>

      <div class="streaming-banner">
        <p data-i18n="streamNotice">All original soundtracks, theatrical scores, and albums are streaming on major platforms.</p>
        <div class="streaming-buttons">
          <a href={socialLinks.spotify} target="_blank" class="stream-btn">Spotify</a>
          <a href={socialLinks.apple} target="_blank" class="stream-btn">Apple Music</a>
          <a href={socialLinks.youtube} target="_blank" class="stream-btn">YouTube</a>
          <a href={socialLinks.itch} target="_blank" class="stream-btn">itch.io</a>
        </div>
      </div>
    </section>

    <!-- About & Methodology -->
    <section id="about" class="section">
      <div class="about-box">
        <div class="about-text">
          <h3 data-i18n="aboutHeading">Profile & Musical Architecture</h3>
          <p data-i18n="aboutP1">
            Composer and sound designer focusing on narrative-driven game scores, theatrical productions, and electroacoustic composition. Combining formal musicological analysis (Sorbonne Université) with modern synthesis and modular audio workflows.
          </p>
          <p data-i18n="aboutP2">
            Available for original soundtrack scoring, interactive audio implementation, and stage sound design collaborations in Paris and internationally.
          </p>

          <div class="profile-links-row">
            <a href="mailto:arhanboraegemen.contact@gmail.com" class="profile-chip">✉ arhanboraegemen.contact@gmail.com</a>
            <a href={socialLinks.tiyatrolar} target="_blank" class="profile-chip">🎭 tiyatrolar.com.tr</a>
            <a href={socialLinks.itch} target="_blank" class="profile-chip">🎮 itch.io</a>
            <a href={socialLinks.instagram} target="_blank" class="profile-chip">Instagram</a>
            <a href={socialLinks.github} target="_blank" class="profile-chip">GitHub</a>
          </div>
        </div>

        <div class="specs-list">
          <div class="spec-group">
            <h4 data-i18n="spec1">Production & Synthesis</h4>
            <div class="spec-tags">
              <span class="spec-tag">Ableton Live 12 Suite</span>
              <span class="spec-tag">FL Studio</span>
              <span class="spec-tag">ReaPlugs DSP</span>
              <span class="spec-tag">Sound Design & Foley</span>
            </div>
          </div>
          <div class="spec-group">
            <h4 data-i18n="spec2">Domains & Theory</h4>
            <div class="spec-tags">
              <span class="spec-tag">Interactive Game Loops</span>
              <span class="spec-tag">Theatrical Cues</span>
              <span class="spec-tag">Formal Musicology</span>
              <span class="spec-tag">Acoustic Arrangement</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Persistent Audio Player Bar -->
  <div class="player-bar">
    <div class="player-inner">
      <div class="player-left">
        <div class="transport-controls">
          <button type="button" id="btn-prev" class="ctrl-icon-btn" aria-label="Previous">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
          </button>
          <button type="button" id="btn-play" class="play-main-btn" aria-label="Play or Pause">
            <svg id="svg-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
            <svg id="svg-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="display:none;"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
          </button>
          <button type="button" id="btn-next" class="ctrl-icon-btn" aria-label="Next">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
          </button>
        </div>

        <div class="now-playing-info">
          <span id="np-title" class="np-title">Arhan Bora Egemen - Select a Track</span>
          <span id="np-sub" class="np-sub">Ready to play</span>
        </div>
      </div>

      <div class="player-center">
        <span id="time-curr" class="time-label">0:00</span>
        <div id="wave-box" class="wave-box">
          <canvas id="waveform"></canvas>
        </div>
        <span id="time-total" class="time-label">0:00</span>
      </div>

      <div class="player-right">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--accent-amber-soft)"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
        <input type="range" id="vol-slider" class="vol-slider" min="0" max="1" step="0.05" value="0.85" />
      </div>
    </div>
  </div>

  <audio id="audio-el" preload="metadata"></audio>

  <script is:inline>
    const dict = {
      en: {
        navWorks: "Works",
        navDisco: "Releases",
        navAbout: "About",
        heroTitle: "Composition & Sound Design for Interactive Media and Stage.",
        heroSub: "Crafting immersive audio experiences for games, theater, and interactive media.",
        secWorks: "Selected Works & Productions",
        filterAll: "All",
        filterTheater: "Theater Scores",
        filterGame: "Game OST",
        filterSfx: "Sound Design / SFX",
        sfxPadTitle: "Interactive Gameplay SFX Triggers:",
        secDisco: "Autonomous Works & Streaming",
        streamNotice: "All original soundtracks, theatrical scores, and albums are streaming on major platforms.",
        aboutHeading: "Profile & Musical Architecture",
        aboutP1: "Composer and sound designer focusing on narrative-driven game scores, theatrical productions, and electroacoustic composition. Combining formal musicological analysis (Sorbonne Université) with modern synthesis and modular audio workflows.",
        aboutP2: "Available for original soundtrack scoring, interactive audio implementation, and stage sound design collaborations in Paris and internationally.",
        spec1: "Production & Synthesis",
        spec2: "Domains & Theory"
      },
      fr: {
        navWorks: "Projets",
        navDisco: "Sorties",
        navAbout: "À Propos",
        heroTitle: "Composition & Sound Design pour Médias Interactifs et Scène.",
        heroSub: "Création d'expériences sonores immersives pour le jeu vidéo, le théâtre et les médias interactifs.",
        secWorks: "Projets & Productions Sélectionnés",
        filterAll: "Tous",
        filterTheater: "Musique de Scène",
        filterGame: "Bande Originale Jeu",
        filterSfx: "Sound Design / SFX",
        sfxPadTitle: "Déclencheurs SFX Interactifs :",
        secDisco: "Œuvres Autonomes & Plateformes",
        streamNotice: "Toutes les bandes originales, musiques de scène et albums sont disponibles sur les plateformes d'écoute.",
        aboutHeading: "Profil & Architecture Musicale",
        aboutP1: "Compositeur et sound designer spécialisé dans les bandes originales de jeux vidéo, la musique de scène et la composition électroacoustique. Alliance entre analyse musicologique formelle (Sorbonne Université) et synthèse sonore moderne.",
        aboutP2: "Disponible pour la composition de bandes originales, l'intégration audio interactive et le sound design théâtral à Paris et à l'international.",
        spec1: "Production & Synthèse",
        spec2: "Domaines & Théorie"
      }
    };

    const langBtns = document.querySelectorAll('.lang-btn');
    const i18nEls = document.querySelectorAll('[data-i18n]');
    const bilingualEls = document.querySelectorAll('[data-en]');

    langBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        langBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        i18nEls.forEach(el => {
          const key = el.getAttribute('data-i18n');
          if (dict[lang][key]) el.textContent = dict[lang][key];
        });

        bilingualEls.forEach(el => {
          const val = el.getAttribute(`data-${lang}`);
          if (val) el.textContent = val;
        });
      });
    });

    // Category Filtering
    const pills = document.querySelectorAll('.pill');
    const projectCards = document.querySelectorAll('.project-card');

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        const filter = pill.getAttribute('data-filter');

        projectCards.forEach(card => {
          const cat = card.getAttribute('data-cat');
          if (filter === 'all' || cat === filter || (filter === 'sfx' && card.querySelector('.sfx-pad-box'))) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Audio Engine & Dual-Tone Waveform
    const audio = document.getElementById('audio-el');
    const btnPlay = document.getElementById('btn-play');
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const svgPlay = document.getElementById('svg-play');
    const svgPause = document.getElementById('svg-pause');
    const npTitle = document.getElementById('np-title');
    const npSub = document.getElementById('np-sub');
    const timeCurr = document.getElementById('time-curr');
    const timeTotal = document.getElementById('time-total');
    const volSlider = document.getElementById('vol-slider');
    const waveBox = document.getElementById('wave-box');
    const canvas = document.getElementById('waveform');
    const ctx = canvas.getContext('2d');

    const playableItems = Array.from(document.querySelectorAll('.playable-item'));
    let currentIndex = -1;
    let audioCtx, analyser, dataArray;
    let isAudioSetup = false;

    function setupAudioGraph() {
      if (isAudioSetup) return;
      try {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 128;
        const srcNode = audioCtx.createMediaElementSource(audio);
        srcNode.connect(analyser);
        analyser.connect(audioCtx.destination);
        dataArray = new Uint8Array(analyser.frequencyBinCount);
        isAudioSetup = true;
      } catch (e) {}
    }

    function resizeCanvas() {
      const dpr = window.devicePixelRatio || 1;
      const w = waveBox.clientWidth || 300;
      const h = waveBox.clientHeight || 34;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function renderWaveform() {
      requestAnimationFrame(renderWaveform);
      const w = waveBox.clientWidth || 300;
      const h = waveBox.clientHeight || 34;
      ctx.clearRect(0, 0, w, h);

      const bars = 48;
      const gap = 3;
      const barWidth = Math.max(2, (w - (bars - 1) * gap) / bars);
      const progressRatio = audio.duration ? (audio.currentTime / audio.duration) : 0;

      if (isAudioSetup && !audio.paused) {
        analyser.getByteFrequencyData(dataArray);
      }

      const gradActive = ctx.createLinearGradient(0, 0, w, 0);
      gradActive.addColorStop(0, '#f59e0b');
      gradActive.addColorStop(0.55, '#c084fc');
      gradActive.addColorStop(1, '#8b5cf6');

      for (let i = 0; i < bars; i++) {
        let amp = 0.22 + Math.sin(i * 0.45) * 0.12;
        if (isAudioSetup && !audio.paused) {
          amp = Math.max(0.15, dataArray[i % dataArray.length] / 255);
        }
        const barH = Math.max(4, amp * (h - 4));
        const x = i * (barWidth + gap);
        const y = (h - barH) / 2;

        const barRatio = i / bars;
        ctx.fillStyle = (barRatio <= progressRatio && !audio.paused) ? gradActive : 'rgba(229, 179, 120, 0.35)';
        ctx.fillRect(x, y, barWidth, barH);
      }
    }
    renderWaveform();

    function formatSec(s) {
      if (!s || isNaN(s)) return "0:00";
      const m = Math.floor(s / 60);
      const sec = Math.floor(s % 60);
      return `${m}:${sec < 10 ? '0' : ''}${sec}`;
    }

    function playItem(index) {
      if (index < 0 || index >= playableItems.length) return;
      setupAudioGraph();
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();

      currentIndex = index;
      const item = playableItems[index];
      const src = item.getAttribute('data-src');
      const title = item.getAttribute('data-title');
      const project = item.getAttribute('data-project');

      playableItems.forEach(el => el.classList.remove('playing'));
      projectCards.forEach(c => c.classList.remove('active-project'));

      item.classList.add('playing');
      const parentCard = item.closest('.project-card');
      if (parentCard) parentCard.classList.add('active-project');

      npTitle.textContent = title;
      npSub.textContent = project;

      audio.src = src;
      audio.play().then(() => {
        svgPlay.style.display = 'none';
        svgPause.style.display = 'block';
      }).catch(() => {
        svgPlay.style.display = 'block';
        svgPause.style.display = 'none';
      });
    }

    playableItems.forEach((item, idx) => {
      item.addEventListener('click', (e) => {
        e.stopPropagation();
        if (currentIndex === idx && !audio.paused) {
          audio.pause();
          svgPlay.style.display = 'block';
          svgPause.style.display = 'none';
        } else if (currentIndex === idx && audio.paused && audio.src) {
          audio.play();
          svgPlay.style.display = 'none';
          svgPause.style.display = 'block';
        } else {
          playItem(idx);
        }
      });
    });

    btnPlay.addEventListener('click', () => {
      if (currentIndex === -1) {
        playItem(0);
        return;
      }
      if (audio.paused) {
        audio.play();
        svgPlay.style.display = 'none';
        svgPause.style.display = 'block';
      } else {
        audio.pause();
        svgPlay.style.display = 'block';
        svgPause.style.display = 'none';
      }
    });

    btnPrev.addEventListener('click', () => {
      if (currentIndex > 0) playItem(currentIndex - 1);
    });

    btnNext.addEventListener('click', () => {
      if (currentIndex < playableItems.length - 1) playItem(currentIndex + 1);
    });

    audio.addEventListener('ended', () => {
      svgPlay.style.display = 'block';
      svgPause.style.display = 'none';
    });

    audio.addEventListener('timeupdate', () => {
      timeCurr.textContent = formatSec(audio.currentTime);
      timeTotal.textContent = formatSec(audio.duration);
    });

    waveBox.addEventListener('click', (e) => {
      if (!audio.duration) return;
      const rect = waveBox.getBoundingClientRect();
      const ratio = (e.clientX - rect.left) / rect.width;
      audio.currentTime = ratio * audio.duration;
    });

    volSlider.addEventListener('input', (e) => {
      audio.volume = e.target.value;
    });
  </script>
</body>
</html>