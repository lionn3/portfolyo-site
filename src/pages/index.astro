<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Arhan Bora Egemen - Composer & Sound Designer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <style is:inline>
    :root {
      --bg-base: #0b0914;
      --card-bg: #151125;
      --card-inner: #1b162f;
      --card-border: #282042;
      --card-hover: #211a3a;
      --accent-violet: #8b5cf6;
      --accent-violet-glow: rgba(139, 92, 246, 0.35);
      --accent-amber: #f59e0b;
      --accent-amber-soft: #e5b378;
      --accent-amber-glow: rgba(245, 158, 11, 0.35);
      --text-main: #f4f1f8;
      --text-muted: #9ca0b3;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      background-color: var(--bg-base);
    }

    body {
      background-color: var(--bg-base);
      background-image:
        radial-gradient(circle at 15% 10%, rgba(139, 92, 246, 0.15) 0%, transparent 45%),
        radial-gradient(circle at 85% 25%, rgba(245, 158, 11, 0.09) 0%, transparent 45%);
      color: var(--text-main);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      line-height: 1.6;
      padding-bottom: 140px;
      min-height: 100vh;
      overflow-x: hidden;
    }

    .container {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* Navbar */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 90;
      background: rgba(11, 9, 20, 0.9);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      padding: 1rem 0;
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .brand {
      font-size: 1.02rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: var(--text-main);
      text-decoration: none;
      white-space: nowrap;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .nav-links {
      display: flex;
      gap: 1.4rem;
      list-style: none;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 500;
      padding-bottom: 0.35rem;
      position: relative;
      transition: color 0.2s;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--text-main);
    }

    .nav-links a.active::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, var(--accent-amber), var(--accent-violet));
      border-radius: 2px;
    }

    .lang-switch {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      border-left: 1px solid var(--card-border);
      border-right: 1px solid var(--card-border);
      padding: 0 0.9rem;
    }

    .lang-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-weight: 600;
      font-size: 0.8rem;
      padding: 0.2rem;
      transition: color 0.2s;
    }

    .lang-btn.active {
      color: var(--accent-amber);
    }

    .platform-icons {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .platform-icons a {
      color: var(--text-muted);
      transition: color 0.2s, transform 0.2s;
      display: flex;
      align-items: center;
    }

    .platform-icons a:hover {
      color: var(--accent-amber-soft);
      transform: translateY(-2px);
    }

    /* Hero */
    .hero {
      text-align: center;
      padding: 4.5rem 0 3.5rem;
      max-width: 840px;
      margin: 0 auto;
    }

    .hero h1 {
      font-size: clamp(2rem, 4vw, 3.1rem);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.025em;
      margin-bottom: 1rem;
      color: var(--text-main);
    }

    .hero p {
      font-size: clamp(0.98rem, 1.8vw, 1.12rem);
      color: var(--accent-amber-soft);
      font-weight: 400;
    }

    /* Sections */
    .section {
      margin-bottom: 4.5rem;
    }

    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .section-title {
      font-size: 1.35rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .filter-pills {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .pill {
      appearance: none;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      color: var(--text-muted);
      font-family: inherit;
      font-size: 0.78rem;
      font-weight: 500;
      padding: 0.4rem 0.95rem;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .pill:hover {
      border-color: var(--accent-violet);
      color: var(--text-main);
    }

    .pill.active {
      background: linear-gradient(135deg, var(--accent-violet), #6d28d9);
      color: #fff;
      border-color: transparent;
      box-shadow: 0 0 14px var(--accent-violet-glow);
    }

    /* Project Cards Grid (2 Columns on Desktop for Multi-Track Playlists + 1:1 Cover) */
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .project-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 1.35rem;
      display: flex;
      flex-direction: column;
      gap: 1.15rem;
      transition: border-color 0.25s, box-shadow 0.25s;
    }

    .project-card:hover {
      border-color: #3f3063;
    }

    .project-card.active-project {
      border-color: var(--accent-amber);
      box-shadow: 0 0 24px rgba(245, 158, 11, 0.15);
    }

    .project-top {
      display: flex;
      gap: 1.15rem;
      align-items: flex-start;
    }

    /* 1:1 Square Cover Container for 3000x3000 Artworks */
    .project-cover {
      width: 115px;
      height: 115px;
      aspect-ratio: 1 / 1;
      border-radius: 10px;
      overflow: hidden;
      flex-shrink: 0;
      background: #0d0a18;
      border: 1px solid rgba(255, 255, 255, 0.08);
      position: relative;
    }

    .project-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .project-info {
      flex: 1;
      min-width: 0;
    }

    .project-meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0.35rem;
      flex-wrap: wrap;
    }

    .project-badge {
      font-size: 0.68rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      padding: 0.2rem 0.6rem;
      border-radius: 5px;
    }

    .project-badge.amber {
      background: rgba(245, 158, 11, 0.14);
      color: var(--accent-amber-soft);
      border: 1px solid rgba(245, 158, 11, 0.3);
    }

    .project-badge.violet {
      background: rgba(139, 92, 246, 0.16);
      color: #c4b5fd;
      border: 1px solid rgba(139, 92, 246, 0.32);
    }

    .ext-link {
      font-size: 0.72rem;
      color: var(--accent-amber-soft);
      text-decoration: none;
      font-weight: 500;
      border: 1px solid rgba(229, 179, 120, 0.3);
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      transition: all 0.2s;
    }

    .ext-link:hover {
      background: var(--accent-amber);
      color: #0b0914;
    }

    .project-title {
      font-size: 1.08rem;
      font-weight: 700;
      color: var(--text-main);
      line-height: 1.25;
      margin-bottom: 0.2rem;
    }

    .project-sub {
      font-size: 0.76rem;
      color: var(--accent-amber-soft);
      margin-bottom: 0.45rem;
    }

    .project-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.45;
    }

    /* Tracklist inside Project Card */
    .tracklist {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      background: var(--card-inner);
      padding: 0.65rem;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.04);
    }

    .track-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.45rem 0.65rem;
      border-radius: 7px;
      cursor: pointer;
      transition: background 0.18s;
    }

    .track-row:hover {
      background: rgba(255, 255, 255, 0.05);
    }

    .track-row.playing {
      background: rgba(245, 158, 11, 0.14);
      border-left: 3px solid var(--accent-amber);
    }

    .track-row-left {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      min-width: 0;
    }

    .mini-play-btn {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      border: none;
      background: rgba(255, 255, 255, 0.08);
      color: var(--text-main);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
    }

    .track-row:hover .mini-play-btn,
    .track-row.playing .mini-play-btn {
      background: var(--accent-amber);
      color: #0b0914;
    }

    .track-row-title {
      font-size: 0.84rem;
      font-weight: 600;
      color: var(--text-main);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .track-row-note {
      font-size: 0.74rem;
      color: var(--text-muted);
      text-align: right;
      white-space: nowrap;
    }

    /* Interactive SFX Pads (for The Final Crystal) */
    .sfx-pad-box {
      padding-top: 0.35rem;
    }

    .sfx-pad-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
      display: block;
    }

    .sfx-pads {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.45rem;
    }

    .sfx-btn {
      appearance: none;
      background: rgba(139, 92, 246, 0.12);
      border: 1px solid rgba(139, 92, 246, 0.3);
      color: var(--text-main);
      font-family: inherit;
      font-size: 0.73rem;
      font-weight: 600;
      padding: 0.45rem 0.3rem;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s;
      text-align: center;
    }

    .sfx-btn:hover,
    .sfx-btn.playing {
      background: var(--accent-violet);
      color: #fff;
      box-shadow: 0 0 12px var(--accent-violet-glow);
    }

    /* Autonomous Releases & Streaming Section */
    .disco-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .release-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      cursor: pointer;
      transition: all 0.2s;
    }

    .release-card:hover {
      border-color: var(--accent-violet);
      background: var(--card-hover);
    }

    .release-card.playing {
      border-color: var(--accent-amber);
      box-shadow: 0 0 20px rgba(245, 158, 11, 0.2);
    }

    .release-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .release-cover {
      width: 72px;
      height: 72px;
      aspect-ratio: 1 / 1;
      border-radius: 8px;
      overflow: hidden;
      flex-shrink: 0;
      background: #0d0a18;
    }

    .release-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .release-title {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-main);
    }

    .release-sub {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .release-play {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--accent-violet);
      color: #fff;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      box-shadow: 0 0 12px var(--accent-violet-glow);
    }

    .streaming-banner {
      background: linear-gradient(135deg, rgba(21, 17, 37, 0.9), rgba(29, 22, 54, 0.9));
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .streaming-banner p {
      font-size: 0.88rem;
      color: var(--text-muted);
    }

    .streaming-buttons {
      display: flex;
      gap: 0.65rem;
      flex-wrap: wrap;
    }

    .stream-btn {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: var(--text-main);
      text-decoration: none;
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.45rem 0.9rem;
      border-radius: 7px;
      transition: all 0.2s;
    }

    .stream-btn:hover {
      background: var(--accent-amber);
      color: #0b0914;
      border-color: var(--accent-amber);
    }

    /* About Box */
    .about-box {
      background: linear-gradient(145deg, rgba(21, 17, 37, 0.95), rgba(14, 11, 26, 0.95));
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 2.2rem;
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 2.5rem;
    }

    .about-text h3 {
      font-size: 1.2rem;
      margin-bottom: 0.8rem;
      color: var(--accent-amber-soft);
    }

    .about-text p {
      color: var(--text-muted);
      font-size: 0.92rem;
      margin-bottom: 0.9rem;
    }

    .profile-links-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 1.1rem;
    }

    .profile-chip {
      font-size: 0.76rem;
      color: var(--text-main);
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
      padding: 0.3rem 0.7rem;
      border-radius: 6px;
      text-decoration: none;
      transition: border-color 0.2s, color 0.2s;
    }

    .profile-chip:hover {
      border-color: var(--accent-amber);
      color: var(--accent-amber);
    }

    .specs-list {
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }

    .spec-group h4 {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--accent-violet);
      margin-bottom: 0.45rem;
    }

    .spec-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .spec-tag {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
      color: var(--text-main);
      font-size: 0.75rem;
      padding: 0.28rem 0.65rem;
      border-radius: 6px;
    }

    /* Persistent Bottom Player Bar */
    .player-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      background: rgba(13, 10, 24, 0.96);
      backdrop-filter: blur(18px);
      border-top: 2px solid var(--accent-amber);
      padding: 0.8rem 1.5rem;
      z-index: 100;
      box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.75);
    }

    .player-inner {
      max-width: 1180px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .player-left {
      display: flex;
      align-items: center;
      gap: 1.1rem;
      min-width: 260px;
      max-width: 340px;
    }

    .transport-controls {
      display: flex;
      align-items: center;
      gap: 0.55rem;
    }

    .ctrl-icon-btn {
      appearance: none;
      background: transparent;
      border: none;
      color: var(--accent-amber-soft);
      cursor: pointer;
      display: flex;
      align-items: center;
      padding: 0.2rem;
    }

    .play-main-btn {
      appearance: none;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--accent-amber);
      color: #0b0914;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 0 15px var(--accent-amber-glow);
      flex-shrink: 0;
    }

    .now-playing-info {
      overflow: hidden;
    }

    .np-title {
      font-size: 0.86rem;
      font-weight: 600;
      color: var(--text-main);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      display: block;
    }

    .np-sub {
      font-size: 0.72rem;
      color: var(--text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      display: block;
    }

    .player-center {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 0.85rem;
      max-width: 540px;
    }

    .time-label {
      font-size: 0.74rem;
      color: var(--text-muted);
      font-variant-numeric: tabular-nums;
      min-width: 34px;
    }

    .wave-box {
      flex: 1;
      height: 34px;
      position: relative;
      cursor: pointer;
      display: flex;
      align-items: center;
    }

    canvas#waveform {
      width: 100%;
      height: 34px;
      display: block;
    }

    .player-right {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    input[type="range"].vol-slider {
      accent-color: var(--accent-amber);
      width: 80px;
      cursor: pointer;
    }

    /* Responsive Breakpoints */
    @media (max-width: 960px) {
      .projects-grid,
      .disco-grid {
        grid-template-columns: 1fr;
      }
      .about-box {
        grid-template-columns: 1fr;
        gap: 1.5rem;
        padding: 1.5rem;
      }
    }

    @media (max-width: 768px) {
      .platform-icons {
        display: none;
      }
      .player-inner {
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .player-left {
        width: 100%;
        max-width: 100%;
      }
      .player-center {
        width: 100%;
        max-width: 100%;
      }
      .player-right {
        display: none;
      }
    }

    @media (max-width: 540px) {
      .project-top {
        flex-direction: column;
      }
      .project-cover {
        width: 100%;
        height: auto;
      }
      .sfx-pads {
        grid-template-columns: repeat(2, 1fr);
      }
      .track-row-note {
        display: none;
      }
    }
  </style>
</head>
<body>

  <nav class="navbar">
    <div class="container nav-inner">
