<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Arhan Bora Egemen — Composer & Sound Designer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <style is:inline>
    :root {
      --bg-base: #0b0914;
      --card-bg: #151125;
      --card-border: #282042;
      --card-hover: #1e1836;
      --accent-violet: #8b5cf6;
      --accent-violet-glow: rgba(139, 92, 246, 0.4);
      --accent-amber: #f59e0b;
      --accent-amber-soft: #e5b378;
      --accent-amber-glow: rgba(245, 158, 11, 0.35);
      --text-main: #f4f1f8;
      --text-muted: #9ca0b3;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    html {
      scroll-behavior: smooth;
      background-color: #0b0914;
    }

    body {
      background-color: var(--bg-base);
      background-image:
        radial-gradient(circle at 18% 12%, rgba(139, 92, 246, 0.16) 0%, transparent 45%),
        radial-gradient(circle at 82% 28%, rgba(245, 158, 11, 0.1) 0%, transparent 45%);
      color: var(--text-main);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      line-height: 1.6;
      padding-bottom: 130px;
      min-height: 100vh;
      overflow-x: hidden;
    }

    .container {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* Navbar */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 90;
      background: rgba(11, 9, 20, 0.9);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      padding: 1.1rem 0;
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .brand {
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: var(--text-main);
      text-decoration: none;
      white-space: nowrap;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 1.8rem;
    }

    .nav-links {
      display: flex;
      gap: 1.6rem;
      list-style: none;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      padding-bottom: 0.4rem;
      position: relative;
      transition: color 0.2s;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--text-main);
    }

    .nav-links a.active::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, var(--accent-amber), var(--accent-violet));
      border-radius: 2px;
    }

    .lang-switch {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-muted);
      border-left: 1px solid var(--card-border);
      border-right: 1px solid var(--card-border);
      padding: 0 1rem;
    }

    .lang-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-weight: 600;
      font-size: 0.82rem;
      padding: 0.2rem 0.3rem;
      transition: color 0.2s;
    }

    .lang-btn.active {
      color: var(--accent-amber);
    }

    .platform-icons {
      display: flex;
      align-items: center;
      gap: 0.9rem;
    }

    .platform-icons a {
      color: var(--text-muted);
      transition: color 0.2s, transform 0.2s;
      display: flex;
      align-items: center;
    }

    .platform-icons a:hover {
      color: var(--accent-amber-soft);
      transform: translateY(-2px);
    }

    /* Hero */
    .hero {
      text-align: center;
      padding: 5rem 0 4rem;
      max-width: 840px;
      margin: 0 auto;
    }

    .hero h1 {
      font-size: clamp(2rem, 4.2vw, 3.2rem);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.025em;
      margin-bottom: 1rem;
      color: var(--text-main);
    }

    .hero p {
      font-size: clamp(1rem, 1.8vw, 1.15rem);
      color: var(--accent-amber-soft);
      font-weight: 400;
    }

    /* Sections */
    .section {
      margin-bottom: 4rem;
    }

    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.4rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .section-title {
      font-size: 1.3rem;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    .filter-pills {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .pill {
      appearance: none;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      color: var(--text-muted);
      font-family: inherit;
      font-size: 0.78rem;
      font-weight: 500;
      padding: 0.4rem 0.9rem;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .pill:hover {
      border-color: var(--accent-violet);
      color: var(--text-main);
    }

    .pill.active {
      background: linear-gradient(135deg, var(--accent-violet), #6d28d9);
      color: #fff;
      border-color: transparent;
      box-shadow: 0 0 14px var(--accent-violet-glow);
    }

    /* 4-Column Works Grid */
    .works-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }

    .work-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      overflow: hidden;
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
      cursor: pointer;
    }

    .work-card:hover {
      transform: translateY(-4px);
      background: var(--card-hover);
      border-color: #3f3063;
    }

    .work-card.playing {
      border-color: var(--accent-amber);
      box-shadow: 0 0 22px var(--accent-amber-glow);
    }

    .work-thumb {
      position: relative;
      height: 150px;
      width: 100%;
      overflow: hidden;
      background: #0d0a18;
    }

    .work-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: brightness(0.85) contrast(1.08);
      transition: transform 0.4s ease;
    }

    .work-card:hover .work-thumb img {
      transform: scale(1.05);
    }

    .work-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      background: rgba(11, 9, 20, 0.82);
      backdrop-filter: blur(6px);
      color: var(--text-main);
      font-size: 0.7rem;
      font-weight: 600;
      padding: 0.25rem 0.65rem;
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.14);
    }

    .work-body {
      padding: 1rem;
      display: flex;
      flex-direction: column;
      flex: 1;
      justify-content: space-between;
      gap: 0.85rem;
    }

    .work-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.45;
    }

    .work-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 0.65rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .work-title {
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--text-main);
    }

    .work-play-btn {
      appearance: none;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      transition: transform 0.2s;
    }

    .work-play-btn.violet {
      background: var(--accent-violet);
      color: #fff;
      box-shadow: 0 0 14px var(--accent-violet-glow);
    }

    .work-play-btn.amber {
      background: var(--accent-amber);
      color: #0b0914;
      box-shadow: 0 0 14px var(--accent-amber-glow);
    }

    /* 4-Column Discography Grid */
    .disco-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }

    .disco-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      overflow: hidden;
      transition: border-color 0.2s, transform 0.2s;
    }

    .disco-card:hover {
      border-color: var(--accent-violet);
      transform: translateY(-3px);
    }

    .disco-cover {
      position: relative;
      height: 140px;
      width: 100%;
      overflow: hidden;
      background: #0d0a18;
    }

    .disco-cover img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: brightness(0.55) contrast(1.1);
      transition: transform 0.35s, filter 0.35s;
    }

    .disco-card:hover .disco-cover img {
      transform: scale(1.05);
      filter: brightness(0.7);
    }

    .disco-overlay-title {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 1.05rem;
      color: #fff;
      text-align: center;
      padding: 0.5rem;
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
    }

    .disco-meta {
      padding: 0.75rem 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.76rem;
      color: var(--text-muted);
    }

    .disco-links {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .disco-links a {
      color: var(--text-main);
      background: rgba(255, 255, 255, 0.06);
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
      text-decoration: none;
      font-size: 0.7rem;
      font-weight: 600;
      transition: background 0.2s, color 0.2s;
    }

    .disco-links a:hover {
      background: var(--accent-amber);
      color: #0b0914;
    }

    /* About Box */
    .about-box {
      background: linear-gradient(145deg, rgba(21, 17, 37, 0.95), rgba(14, 11, 26, 0.95));
      border: 1px solid var(--card-border);
      border-radius: 14px;
      padding: 2.2rem;
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 2.5rem;
    }

    .about-text h3 {
      font-size: 1.2rem;
      margin-bottom: 0.8rem;
      color: var(--accent-amber-soft);
    }

    .about-text p {
      color: var(--text-muted);
      font-size: 0.94rem;
      margin-bottom: 0.9rem;
    }

    .specs-list {
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }

    .spec-group h4 {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--accent-violet);
      margin-bottom: 0.45rem;
    }

    .spec-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .spec-tag {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--card-border);
      color: var(--text-main);
      font-size: 0.75rem;
      padding: 0.28rem 0.65rem;
      border-radius: 6px;
    }

    /* Persistent Bottom Player Bar */
    .player-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      background: rgba(13, 10, 24, 0.96);
      backdrop-filter: blur(18px);
      border-top: 2px solid var(--accent-amber);
      padding: 0.85rem 1.5rem;
      z-index: 100;
      box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.7);
    }

    .player-inner {
      max-width: 1180px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .player-left {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      min-width: 250px;
    }

    .transport-controls {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .ctrl-icon-btn {
      appearance: none;
      background: transparent;
      border: none;
      color: var(--accent-amber-soft);
      cursor: pointer;
      display: flex;
      align-items: center;
      padding: 0.2rem;
    }

    .play-main-btn {
      appearance: none;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--accent-amber);
      color: #0b0914;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 0 15px var(--accent-amber-glow);
    }

    .now-playing-info {
      overflow: hidden;
    }

    .np-title {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text-main);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      display: block;
    }

    .np-sub {
      font-size: 0.74rem;
      color: var(--text-muted);
      display: block;
    }

    .player-center {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 0.85rem;
      max-width: 540px;
    }

    .time-label {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-variant-numeric: tabular-nums;
      min-width: 35px;
    }

    .wave-box {
      flex: 1;
      height: 34px;
      position: relative;
      cursor: pointer;
      display: flex;
      align-items: center;
    }

    canvas#waveform {
      width: 100%;
      height: 34px;
      display: block;
    }

    .player-right {
      display: flex;
      align-items: center;
      gap: 0.7rem;
    }

    input[type="range"].vol-slider {
      accent-color: var(--accent-amber);
      width: 80px;
      cursor: pointer;
    }

    /* Responsive Breakpoints */
    @media (max-width: 1024px) {
      .works-grid,
      .disco-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      .about-box {
        grid-template-columns: 1fr;
        gap: 1.5rem;
        padding: 1.5rem;
      }
      .platform-icons {
        display: none;
      }
      .player-inner {
        flex-wrap: wrap;
        gap: 0.6rem;
      }
      .player-left {
        width: 100%;
        justify-content: space-between;
      }
      .player-center {
        width: 100%;
        max-width: 100%;
      }
      .player-right {
        display: none;
      }
    }

    @media (max-width: 540px) {
      .works-grid,
      .disco-grid {
        grid-template-columns: 1fr;
      }
      .nav-links {
        gap: 0.9rem;
      }
      .hero {
        padding: 3rem 0 2.2rem;
      }
    }
  </style>
</head>
<body>

  <nav class="navbar">
    <div class="container nav-inner">
      <a href="#" class="brand">ARHAN BORA EGEMEN</a>

      <div class="nav-right">
        <ul class="nav-links">
          <li><a href="#works" class="active" data-i18n="navWorks">Works</a></li>
          <li><a href="#discography" data-i18n="navDisco">Discography</a></li>
          <li><a href="#about" data-i18n="navAbout">About</a></li>
        </ul>

        <div class="lang-switch">
          <button type="button" class="lang-btn active" data-lang="en">EN</button>
          <span>|</span>
          <button type="button" class="lang-btn" data-lang="fr">FR</button>
        </div>

        <div class="platform-icons">
          <a href="https://open.spotify.com" target="_blank" title="Spotify" aria-label="Spotify">
